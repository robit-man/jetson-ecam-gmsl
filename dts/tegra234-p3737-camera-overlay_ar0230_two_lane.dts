/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>

#define RST_IO_EXP     TEGRA234_MAIN_GPIO(AC, 1)
#define PWM_CALIB_GPIO	TEGRA234_MAIN_GPIO(H, 6)
#define TRIGGER_SEL	TEGRA234_MAIN_GPIO(H, 3) 

#define CAM_LANES 2
#define CAM_LANES_STRING "2"

/ {
	overlay-name = "Jetson Camera STURDECAM20-AR0230";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

    	fragment@0 {
			target-path = "/";
			__overlay__ {
	bus@0 {
		gpio@2200000 {
			camera-control-output-high {
                        status = "okay";
                        gpio-hog;
                        gpios = <RST_IO_EXP 0>;
                        output-high;
                        label = "rst-io-expender";
                };
		camera-control-output-low {
                        status = "okay";
			gpio-hog;
			gpios = <TRIGGER_SEL 0>;
			output-low;
			label = "trigger_sel";
		    };
	    };
	i2c@31e0000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		tca6424_22: tca6424@22 {
			compatible = "ti,tca6424";
			gpio-controller;
			#gpio-cells = <2>;
			reg = <0x22>;
            		vcc-supply = <&vdd_1v8_sys>;
			reset = <&gpio RST_IO_EXP GPIO_ACTIVE_HIGH>;
			trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>;
			status = "okay";
		};
	};


	i2c@3180000 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		tca9548@70 {
			status = "okay";
            		compatible = "nxp,pca9548";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;
			vcc-supply = <&vdd_1v8_sys>;
			skip_mux_detect;
			force_bus_start = <0x1e>;
			i2c@0 {
				status = "okay";
				reg = <0>;
				i2c-mux,deselect-on-exit;
				#address-cells = <1>;
				#size-cells = <0>;
				ar0230_b@44 {
					status = "okay";
					compatible = "nvidia,ar0230";
					reg = <0x44>;
					sensor_model ="ar0230";
					dev_name = "ecam_gmsl 9-0044";
					mcu_fw_name = "ar0230_mcu_fw.bin";
					avdd-reg = "vana";
					iovdd-reg = "vif";
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
							 <&bpmp TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					clock-frequency = <24000000>;
					boot-gpios = <&tca6424_22 0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 3 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>;
					default-trigger = "internal"; 
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					use_sensor_mode_id = "false";
					camera_mipi_lanes = <CAM_LANES>;
					camera-mipi-clk = <1200>;	
					sio-port = "B";
					pwm-invert= <1>;
                                        pwm-duty_ns = <0x1F191B7>;
                                        pwm-period_ns = <0x228DACC>;
                                        pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
                                        pwm-name = "ecam-trigger";
#define TEGRA_SINTERFACE "serial_b"
#include "ar0230_cuxvr_mode.dtsi"	
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							status = "okay";
							reg = <0>;
							ecam_ar0230_out1: endpoint {
								status = "okay";
								port-index = <1>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&ecam_csi_in1>;
							};
						};
					};
				};
				ar0230_a@43 {
					status = "okay";
					compatible = "nvidia,ar0230";
					reg = <0x43>;
					sensor_model ="ar0230";
					dev_name = "ecam_gmsl 9-0043";
					mcu_fw_name = "ar0230_mcu_fw.bin";
					avdd-reg = "vana";
					iovdd-reg = "vif";
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
							 <&bpmp TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					clock-frequency = <24000000>;
					boot-gpios = <&tca6424_22 0 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 3 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>;
					default-trigger = "internal"; 
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					use_sensor_mode_id = "false";
					camera_mipi_lanes = <CAM_LANES>;
					camera-mipi-clk = <1200>;	
					sio-port = "A";
					pwm-invert= <1>;
					pwm-duty_ns = <0x1F191B7>;
					pwm-period_ns = <0x228DACC>;
					pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
					pwm-name = "ecam-trigger";	
#undef TEGRA_SINTERFACE	
#define TEGRA_SINTERFACE "serial_a"
#include "ar0230_cuxvr_mode.dtsi"	
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							status = "okay";
							reg = <0>;
							ecam_ar0230_out0: endpoint {
								status = "okay";
								port-index = <0>;
								bus-width = <CAM_LANES>;
								remote-endpoint = <&ecam_csi_in0>;
							};
						};
					};
				};
				};
			i2c@1 {
                               status = "okay";
                               reg = <1>;
                               i2c-mux,deselect-on-exit;
                               #address-cells = <1>;
                               #size-cells = <0>;
                               ar0230_d@44 {
					status = "okay";
					compatible = "nvidia,ar0230";
					reg = <0x44>;
					sensor_model ="ar0230";
					dev_name = "ecam_gmsl 10-0044";
					mcu_fw_name = "ar0230_mcu_fw.bin";
					avdd-reg = "vana";
					iovdd-reg = "vif";
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					clock-frequency = <24000000>;
					boot-gpios = <&tca6424_22 1 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 4 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>; 
					use_sensor_mode_id = "false";
					camera_mipi_lanes = <CAM_LANES>;
					camera-mipi-clk = <1200>;	
					sio-port = "B";
					pwm-invert= <1>;
					pwm-duty_ns = <0x1F191B7>;
					pwm-period_ns = <0x228DACC>;
					pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
					pwm-name = "ecam-trigger";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_d"
#include "ar0230_cuxvr_mode.dtsi"
					ports {
						status = "okay";
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							status = "okay";
                                                       reg = <0>;
                                                       ecam_ar0230_out3: endpoint {
                                                               status = "okay";
                                                               port-index = <3>;
                                                               bus-width = <CAM_LANES>;
                                                               remote-endpoint = <&ecam_csi_in3>;
                                                       };
                                               };
                                       };
                               };

			ar0230_c@43 {
                                        status = "okay";
                                        compatible = "nvidia,ar0230";
                                        reg = <0x43>;
                                        sensor_model ="ar0230";
					dev_name = "ecam_gmsl 10-0043";
					mcu_fw_name = "ar0230_mcu_fw.bin";
					avdd-reg = "vana";
					iovdd-reg = "vif";
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					clock-frequency = <24000000>;
					boot-gpios = <&tca6424_22 1 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 4 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>; 
					use_sensor_mode_id = "false";
					camera_mipi_lanes = <CAM_LANES>;
					camera-mipi-clk = <1200>;	
					sio-port = "A";
					pwm-invert= <1>;
					pwm-duty_ns = <0x1F191B7>;
					pwm-period_ns = <0x228DACC>;
					pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
					pwm-name = "ecam-trigger";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_c"
#include "ar0230_cuxvr_mode.dtsi"
                                       ports {
                                       status = "okay";
                                       #address-cells = <1>;
                                       #size-cells = <0>;
                                               port@0 {
                                                       status = "okay";
                                                       reg = <0>;
                                                       ecam_ar0230_out2: endpoint {
                                                               status = "okay";
                                                               port-index = <2>;
                                                               bus-width = <CAM_LANES>;
                                                               remote-endpoint = <&ecam_csi_in2>;
                                                       };
                                               };
                                       };
                               };
			};

                       i2c@2 {
                               status = "okay";
                               reg = <2>;
                               i2c-mux,deselect-on-exit;
                               #address-cells = <1>;
                               #size-cells = <0>;
                               ar0230_f@44 {
					status = "okay";
					compatible = "nvidia,ar0230";
					reg = <0x44>;
					sensor_model ="ar0230";
					dev_name = "ecam_gmsl 11-0044";
					mcu_fw_name = "ar0230_mcu_fw.bin";
					avdd-reg = "vana";
					iovdd-reg = "vif";
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
					clock-names = "extperiph1", "pllp_grtba";
					mclk = "extperiph1";
					clock-frequency = <24000000>;
					boot-gpios = <&tca6424_22 2 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 5 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>; 
					use_sensor_mode_id = "false";
					camera_mipi_lanes = <CAM_LANES>;
					camera-mipi-clk = <1200>;	
					sio-port = "B";
					pwm-invert = <1>;
					pwm-duty_ns = <0x1F191B7>;
					pwm-period_ns = <0x228DACC>;
					pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
					pwm-name = "ecam-trigger";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_f"
#include "ar0230_cuxvr_mode.dtsi"
                                       ports {
                                       status = "okay";
                                       #address-cells = <1>;
                                       #size-cells = <0>;
                                               port@0 {
                                                       status = "okay";
                                                       reg = <0>;
                                                       ecam_ar0230_out5: endpoint {
                                                               status = "okay";
                                                               port-index = <6>;
                                                               bus-width = <CAM_LANES>;
                                                               remote-endpoint = <&ecam_csi_in5>;
                                                       };
                                               };
                                       };
				};
				ar0230_e@43 {
					status = "okay";
					compatible = "nvidia,ar0230";
					reg = <0x43>;
					sensor_model ="ar0230";
					dev_name = "ecam_gmsl 11-0043";
					mcu_fw_name = "ar0230_mcu_fw.bin";
                                        avdd-reg = "vana";
                                        iovdd-reg = "vif";
					//vana-supply = <&p3737_avdd_cam_2v8>;
					//vif-supply = <&vdd_1v8_sys>;
					clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
                                        clock-names = "extperiph1", "pllp_grtba";
                                        mclk = "extperiph1";
                                        clock-frequency = <24000000>;
                                        boot-gpios = <&tca6424_22 2 GPIO_ACTIVE_HIGH>;
					pwdn-gpios = <&tca6424_22 5 GPIO_ACTIVE_HIGH>;
					trigger-gpios = <&gpio TRIGGER_SEL GPIO_ACTIVE_LOW>; 
                                        use_sensor_mode_id = "false";
                                        camera_mipi_lanes = <CAM_LANES>;
				                        camera-mipi-clk = <1200>;	
                                        sio-port = "A";
					pwm-invert= <1>;
					pwm-duty_ns = <0x1F191B7>;
                                        pwm-period_ns = <0x228DACC>;
                                        pwm-calib-gpio = <&gpio PWM_CALIB_GPIO GPIO_ACTIVE_HIGH>;
                                        pwm-name = "ecam-trigger";
#undef TEGRA_SINTERFACE
#define TEGRA_SINTERFACE "serial_e"
#include "ar0230_cuxvr_mode.dtsi"
                                       ports {
                                       status = "okay";
                                       #address-cells = <1>;
                                       #size-cells = <0>;
                                               port@0 {
                                                       status = "okay";
                                                       reg = <0>;
                                                       ecam_ar0230_out4: endpoint {
                                                               status = "okay";
                                                               port-index = <4>;
                                                               bus-width = <CAM_LANES>;
                                                               remote-endpoint = <&ecam_csi_in4>;
                                                       };
                                               };
                                       };
                               };
			};
		};
	};
	

	host1x@13e00000 {

		nvcsi@15a00000 {
			num-channels = <6>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			channel@0 {
				reg = <0>;
				status = "okay";
				ports {
                    			status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						status = "okay";
						ecam_csi_in0: endpoint@0 {
							status = "okay";
							port-index = <0>;
							bus-width = <CAM_LANES>;
							remote-endpoint = <&ecam_ar0230_out0>;
						};
					};
					port@1 {
						reg = <1>;
						status = "okay";
						ecam_csi_out0: endpoint@1 {
							status = "okay";
							remote-endpoint = <&ecam_vi_in0>;
						};
					};
				};
			};
            channel@1 {
		reg = <1>;
		status = "okay";
		ports {
                    status = "okay";
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
			reg = <0>;
			status = "okay";
                     	ecam_csi_in1: endpoint@2 {
			     status = "okay";
                            port-index = <1>;
                            bus-width = <CAM_LANES>;
                            remote-endpoint = <&ecam_ar0230_out1>;
                        };
                    };
                    port@1 {
			reg = <1>;
			status = "okay";
                       ecam_csi_out1: endpoint@3 {
				status = "okay";
                            	remote-endpoint = <&ecam_vi_in1>;
                        };
                    };
                };
            };
            channel@2 {
               	reg = <2>;
			status = "okay";
                       ports {
				status = "okay";
                             	#address-cells = <1>;
                             	#size-cells = <0>;
				port@0 {
                                  	reg = <0>;
					status = "okay";
                                       ecam_csi_in2: endpoint@4 {
							  status = "okay";
                                                        port-index = <2>;
                                                        bus-width = <CAM_LANES>;
                                                        remote-endpoint = <&ecam_ar0230_out2>;
                                                };
                                        };
                                        port@1 {
                                                reg = <1>;
						  status = "okay";
                                                ecam_csi_out2: endpoint@5 {
							  status = "okay";
                                                        remote-endpoint = <&ecam_vi_in2>;
                                                };
                                        };
                                };
                        };

			channel@3 {
                                reg = <3>; 
				 status = "okay";
                                ports {
                                        status = "okay";
                                        #address-cells = <1>;
                                        #size-cells = <0>;
                                        port@0 {
                                                reg = <0>;
						  status = "okay";
                                                ecam_csi_in3: endpoint@6 {
							  status = "okay";
                                                        port-index = <3>;
                                                        bus-width = <CAM_LANES>;
                                                        remote-endpoint = <&ecam_ar0230_out3>;
                                                };
                                        };
                                        port@1 {
                                                reg = <1>;
						  status = "okay";
                                                ecam_csi_out3: endpoint@7 {
							  status = "okay";
                                                        remote-endpoint = <&ecam_vi_in3>;
                                                };
                                        };
                                };
                        };
			channel@4 {
                                reg = <4>;
				 status = "okay";
                                ports {
                                        status = "okay";
                                        #address-cells = <1>;
                                        #size-cells = <0>;
                                        port@0 {
                                                reg = <0>;
						  status = "okay";
                                                ecam_csi_in4: endpoint@8 {
							  status = "okay";
                                                        port-index = <4>;
                                                        bus-width = <CAM_LANES>;
                                                        remote-endpoint = <&ecam_ar0230_out4>;
                                                };
                                        };
                                        port@1 {
                                                reg = <1>;
						  status = "okay";
                                                ecam_csi_out4: endpoint@9 {
							status = "okay";
                                                	remote-endpoint = <&ecam_vi_in4>;
                                                };
                                        };
                                };
                        };
			channel@5 {
				reg = <5>;
				status = "okay";
				ports {
                   		 	status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						status = "okay";
						ecam_csi_in5: endpoint@10 {
							status = "okay";
							port-index = <6>;
							bus-width = <CAM_LANES>;
							remote-endpoint = <&ecam_ar0230_out5>;
						};
					};
					port@1 {
						reg = <1>;
						status = "okay";
						ecam_csi_out5: endpoint@11 {
							status = "okay";
							remote-endpoint = <&ecam_vi_in5>;
						};
					};
				};
			};
		};
	};
};	

// all cameras are disabled by default 
    capture_vi_base: tegra-capture-vi  {
			num-channels = <6>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;	
				status = "okay";
				port@0 {
					reg = <0>;
					status = "okay";
					ecam_vi_in0: endpoint {
						status = "okay";
				 		port-index = <0>;
				 		bus-width = <CAM_LANES>;
				 		remote-endpoint = <&ecam_csi_out0>;
			 		};
				};
				port@1 {
					reg = <1>;
					status = "okay";
					ecam_vi_in1: endpoint {
						status = "okay";
				 		port-index = <1>;
				 		bus-width = <CAM_LANES>;
				 		remote-endpoint = <&ecam_csi_out1>;
			 		};
				};
				port@2 {
					reg = <2>;
					status = "okay";
					ecam_vi_in2: endpoint {
						status = "okay";
						port-index = <2>;
				 		bus-width = <CAM_LANES>;
				 		remote-endpoint = <&ecam_csi_out2>;
			 		};
				};
				port@3 {
					reg = <3>;
					status = "okay";
					ecam_vi_in3: endpoint {
						status = "okay";
		   				port-index = <3>;
						bus-width = <CAM_LANES>;
						remote-endpoint = <&ecam_csi_out3>;				
					};
				};
				 port@4 {
				    reg = <4>;
				    ecam_vi_in4: endpoint {
							    status= "okay";
				        port-index = <4>;
				        bus-width = <CAM_LANES>;
				        remote-endpoint = <&ecam_csi_out4>;
				    };
				};
				port@5 {
				    reg = <5>;
				    ecam_vi_in5: endpoint {
							status= "okay";
				        port-index = <5>;
				        bus-width = <CAM_LANES>;
				        remote-endpoint = <&ecam_csi_out5>;
				    };
				};
			};
		};
        

	 tcp: tegra-camera-platform {
		status = "okay";
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <16>;
		max_lane_speed = <2500000>;
		min_bits_per_pixel = <16>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <67>;
		max_pixel_rate = <750000>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;

		modules {
			status = "okay";
			module0 {
				badge = "nilecam20_cuxvr";
				position = "bottomleft";
				orientation = "1";
				status = "okay";
                		drivernode0 {
					pcl_id = "v4l2_sensor";
